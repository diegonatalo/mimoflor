# Copie este arquivo para .env.local e preencha. Na Vercel, as mesmas variáveis
# ficam em Settings > Environment Variables (as do banco vêm da integração Neon).

# URL pública do site, usada nas tags Open Graph, no robots.txt e no sitemap.xml (sem barra no final).
NEXT_PUBLIC_SITE_URL=https://mimoflor.vercel.app

# Banco Postgres (Neon). Em desenvolvimento, use a URL da branch "dev", nunca a de produção.
# O nome do banco precisa terminar em _dev: fora disso, o `pnpm dev`, o E2E e o `db:migrate` param (lib/dev-database.ts).
# A versão sem pooler é usada pelas migrações (`pnpm db:migrate`); se faltar, vale a DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Chave do HMAC que embaralha o IP na contagem de flores por hora. Gere com
# `openssl rand -base64 32`, uma diferente em cada ambiente. Sem ela, cada
# servidor sorteia a sua (o limite passa a contar separado em cada instância).
RATE_LIMIT_SECRET=
